NEXUS_MODE=admin-local
NEXUS_HOST=127.0.0.1
NEXUS_PORT=3000
EVERYTHING_URL=http://127.0.0.1:8888/
# Generate locally with npm run setup. Never commit .env.
NEXUS_ADMIN_HASH=
# Fictional example; use only roots explicitly approved for this administrator.
NEXUS_ROOTS=[{"path":"C:\\ExampleData","unc":"\\\\example-server\\example-share"}]
NEXUS_DOWNLOADS=false

# Optional LAN mode requires a trusted TLS certificate and exact HTTPS origin.
# NEXUS_MODE=accounts
# NEXUS_HOST=0.0.0.0
# NEXUS_PORT=3443
# NEXUS_PUBLIC_ORIGIN=https://nexus.example.internal:3443
# NEXUS_TLS_CERT=C:\ExampleCertificates\server-chain.pem
# NEXUS_TLS_KEY=C:\ExampleCertificates\server-key.pem
# NEXUS_USERS_FILE defaults to data/users.json beside the application.
